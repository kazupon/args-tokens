{
  "name": "args-tokens",
  "description": "parseArgs tokens compatibility and more high-performance parser",
  "version": "0.28.2",
  "author": {
    "name": "kazuya kawaguchi",
    "email": "kawakazu80@gmail.com"
  },
  "license": "MIT",
  "funding": "https://github.com/sponsors/kazupon",
  "bugs": {
    "url": "https://github.com/kazupon/args-tokens/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazupon/args-tokens.git"
  },
  "keywords": [
    "args",
    "args-parser",
    "cli",
    "parseargs",
    "tokens"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">= 22"
  },
  "type": "module",
  "files": [
    "lib"
  ],
  "module": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./parser": {
      "types": "./lib/parser.d.ts",
      "import": "./lib/parser.js",
      "require": "./lib/parser.js",
      "default": "./lib/parser.js"
    },
    "./resolver": {
      "types": "./lib/resolver.d.ts",
      "import": "./lib/resolver.js",
      "require": "./lib/resolver.js",
      "default": "./lib/resolver.js"
    },
    "./utils": {
      "types": "./lib/utils.d.ts",
      "import": "./lib/utils.js",
      "require": "./lib/utils.js",
      "default": "./lib/utils.js"
    },
    "./combinators": {
      "types": "./lib/combinators.d.ts",
      "import": "./lib/combinators.js",
      "require": "./lib/combinators.js",
      "default": "./lib/combinators.js"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "types": "lib/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./lib/*",
        "./*"
      ]
    }
  },
  "scripts": {
    "bench:mitata": "node --expose-gc bench/mitata.js",
    "bench:positionals": "node --expose-gc bench/positionals.js",
    "bench:vitest": "vp test bench --run",
    "build": "vp pack",
    "build:docs": "node scripts/generate-docs.mjs",
    "check": "vp check && knip && deno check src",
    "fix": "vp check --fix",
    "lint:jsr": "jsr publish --config jsr.json --dry-run --allow-dirty",
    "prepack": "vp pack",
    "prepare": "vp config --no-agent",
    "release": "bumpp",
    "test": "vp test"
  },
  "devDependencies": {
    "@kazupon/vp-config": "^0.5.1",
    "@types/node": "^25.9.5",
    "bumpp": "^12.0.0",
    "deno": "^2.9.5",
    "gh-changelogen": "^2.0.2",
    "jsr": "^0.14.3",
    "jsr-exports-lint": "^0.4.2",
    "knip": "^6.32.2",
    "mitata": "^1.0.34",
    "pkg-pr-new": "^0.0.88",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitepress-api-references": "^0.3.0",
    "zod": "^4.4.3"
  }
}
